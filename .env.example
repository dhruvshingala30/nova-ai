ENVIRONMENT=production

# Toggle between local Ollama and Cloud APIs
USE_CLOUD_LLM=false

# Cloud Inference Credentials
GROQ_API_KEY=your_groq_api_key_here
CLOUD_MODEL_NAME=openai/gpt-oss-20b
CLOUD_VISION_MODEL=qwen/qwen3.8-27b

# Cloud Sandbox Credentials
E2B_API_KEY=your_e2b_api_key_here

# Local Paths & Defaults
DATABASE_PATH=data/nova.db
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=qwen2.5:7b-instruct-q8_0