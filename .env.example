ENVIRONMENT=production

# Toggle between local Ollama and Cloud APIs
USE_CLOUD_LLM=true

# Cloud Inference Credentials
CLOUD_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=your_groq_api_key_here
CLOUD_MODEL_NAME=deepseek/deepseek-v4.1-flash20b
CLOUD_VISION_MODEL=deepseek/deepseek-v4.1-flash

# Cloud Sandbox Credentials
E2B_API_KEY=your_e2b_api_key_here

# Search Engine Tavily Credentials
TAVILY_API_KEY=your_tavily_api_key_here

# Local Paths & Defaults
DATABASE_PATH=data/nova.db
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=qwen2.5:7b-instruct-q8_0
VISION_MODEL_NAME=llava